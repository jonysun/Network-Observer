{
  "server_address": "observer.example.lan:8444",
  "ca_cert_file": "/etc/network-observer/ca.crt",
  "security_mode": true,
  "enrollment_token": "persistent-token",
  "device_id": "issued-by-register-command",
  "device_name": "lab-gateway-01",
  "observer_type": "gateway",
  "wal_path": "/var/lib/network-observer/agent.wal",
  "wal_max_bytes": 268435456,
  "ebpf_mode": "off",
  "ebpf_object_path": "/usr/local/lib/network-observer/flow_counter.o",
  "ebpf_cgroup_path": "/sys/fs/cgroup",
  "dns_metadata_enabled": false,
  "conntrack_path": "/proc/net/nf_conntrack",
  "netflow_listen": ":2055",
  "ipfix_listen": ":4739",
  "sflow_listen": ":6343"
}
