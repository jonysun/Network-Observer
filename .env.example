POSTGRES_PASSWORD=change-this-postgres-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Optional legacy token for already registered devices. New devices use a
# one-time token generated from the Center's 添加设备 page.
ENROLLMENT_TOKEN=
# DNS name or IP without scheme/port. Center automatically creates a
# self-signed certificate in its persistent TLS volume on first startup.
# Existing certificates in that volume are preserved.
TLS_CERT_HOST=observer.example.lan
HTTP_ADDR=0.0.0.0:8080
GRPC_ADDR=0.0.0.0:8443
WEB_PORT=8443
# Optional HTTP-only OpenWrt bootstrap port. It exposes only fixed release assets.
CENTER_BOOTSTRAP_PORT=8080
AGENT_GRPC_PORT=8444
# 可选：让 Center 所在 NAS 宿主机也作为一个 Endpoint Agent 上报。
# 首次启动前，在 Center Web 的“设备 → 添加设备”生成一次性 Endpoint Token。
# 将公开证书放到 examples/center/light/center-agent/ca.crt；不要复制私钥。
CENTER_AGENT_ENROLLMENT_TOKEN=
# 以下自监控选项不填即使用默认值；自动生成的证书包含 127.0.0.1。
# CENTER_AGENT_NAME=center-host
# CENTER_AGENT_SERVER=127.0.0.1:8444
# CENTER_AGENT_TLS_SERVER_NAME=127.0.0.1
# CENTER_AGENT_SECURITY_MODE=true
GRAFANA_PORT=3000
POSTGRES_DSN=postgres://observer:change-this-postgres-password@postgres:5432/observer?sslmode=disable
CLICKHOUSE_DSN=clickhouse://clickhouse:9000/observer?username=observer&password=change-this-clickhouse-password
CLICKHOUSE_PASSWORD=change-this-clickhouse-password
SUMMARY_RETENTION_DAYS=90
AGENT_WAL_MAX_BYTES=268435456
# Used only with docker-compose.pro.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password


# Center remote-upgrade target for native Linux Agents
AGENT_RELEASE_VERSION=v0.3.42
AGENT_RELEASE_BASE_URL=https://github.com/jonysun/Network-Observer/releases/download
