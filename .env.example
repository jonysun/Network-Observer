POSTGRES_PASSWORD=change-this-postgres-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Optional legacy token for already registered devices. New devices use a
# one-time token generated from the Center's 添加设备 page.
ENROLLMENT_TOKEN=
SERVER_PUBLIC_URL=observer.example.lan:8444
TLS_CERT_FILE=./deploy/tls/server.crt
TLS_KEY_FILE=./deploy/tls/server.key
HTTP_ADDR=0.0.0.0:8080
GRPC_ADDR=0.0.0.0:8443
WEB_PORT=8443
AGENT_GRPC_PORT=8444
GRAFANA_PORT=3000
POSTGRES_DSN=postgres://observer:change-this-postgres-password@postgres:5432/observer?sslmode=disable
CLICKHOUSE_DSN=clickhouse://clickhouse:9000/observer?username=observer&password=change-this-clickhouse-password
CLICKHOUSE_PASSWORD=change-this-clickhouse-password
SUMMARY_RETENTION_DAYS=90
IP_ENRICHMENT_ASN_MMDB=/data/enrichment/GeoLite2-ASN.mmdb
IP_ENRICHMENT_CITY_MMDB=/data/enrichment/GeoLite2-City.mmdb
AGENT_WAL_MAX_BYTES=268435456
# Used only with docker-compose.pro.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

